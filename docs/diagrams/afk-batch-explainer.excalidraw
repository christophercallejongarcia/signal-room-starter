    {"type": "rectangle", "id": "p1", "x": 1010, "y": 930, "width": 790, "height": 100, "angle": 0, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 300050, "version": 1, "versionNonce": 300051, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false},
    {"type": "text", "id": "t_p1", "x": 1030, "y": 944, "width": 750, "height": 80, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 300052, "version": 1, "versionNonce": 300053, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Stufen statt verschachtelter Schleife\nQueue zwischen den Stufen, jede Stufe ein eigener Worker.\nQuelle: Mark", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Stufen statt verschachtelter Schleife\nQueue zwischen den Stufen, jede Stufe ein eigener Worker.\nQuelle: Mark", "lineHeight": 1.25},
    {"type": "rectangle", "id": "p2", "x": 1010, "y": 1050, "width": 790, "height": 100, "angle": 0, "strokeColor": "#6d28d9", "backgroundColor": "#ddd6fe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 300054, "version": 1, "versionNonce": 300055, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false},
    {"type": "text", "id": "t_p2", "x": 1030, "y": 1064, "width": 750, "height": 80, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 300056, "version": 1, "versionNonce": 300057, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Subagents = Kontext-Isolation, kein Speed-Button\n4 Runs wurden 4/4 grün, kosteten aber 58 % mehr bei null Speedup.\nQuelle: Matthew Snow", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Subagents = Kontext-Isolation, kein Speed-Button\n4 Runs wurden 4/4 grün, kosteten aber 58 % mehr bei null Speedup.\nQuelle: Matthew Snow", "lineHeight": 1.25},
    {"type": "rectangle", "id": "p3", "x": 1010, "y": 1170, "width": 790, "height": 100, "angle": 0, "strokeColor": "#6d28d9", "backgroundColor": "#ddd6fe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 300058, "version": 1, "versionNonce": 300059, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false},
    {"type": "text", "id": "t_p3", "x": 1030, "y": 1184, "width": 750, "height": 80, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 300060, "version": 1, "versionNonce": 300061, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Review nie im selben Kontext wie die Implementierung\nDer Verifier bekommt ein eigenes Fenster.\nQuelle: Mark", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Review nie im selben Kontext wie die Implementierung\nDer Verifier bekommt ein eigenes Fenster.\nQuelle: Mark", "lineHeight": 1.25},
    {"type": "rectangle", "id": "p4", "x": 1010, "y": 1290, "width": 790, "height": 100, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "#fef3c7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 300062, "version": 1, "versionNonce": 300063, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false},
    {"type": "text", "id": "t_p4", "x": 1030, "y": 1304, "width": 750, "height": 80, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 300064, "version": 1, "versionNonce": 300065, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Reset = neuer headless Run, nicht /clear\nEin Ticket pro frischem Prozess, ohne Bias aus der letzten Session.\nQuelle: Niko, Jack, Mark", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Reset = neuer headless Run, nicht /clear\nEin Ticket pro frischem Prozess, ohne Bias aus der letzten Session.\nQuelle: Niko, Jack, Mark", "lineHeight": 1.25}
