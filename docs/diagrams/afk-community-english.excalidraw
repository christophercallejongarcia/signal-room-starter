    {"type": "rectangle", "id": "d1", "x": 80, "y": 850, "width": 400, "height": 120, "angle": 0, "strokeColor": "#1e3a5f", "backgroundColor": "#dbeafe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 220050, "version": 1, "versionNonce": 220051, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false},
    {"type": "text", "id": "t_d1", "x": 96, "y": 866, "width": 370, "height": 95, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 220052, "version": 1, "versionNonce": 220053, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Plan declares the seams.\nNo human seam approval\ninside the run.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Plan declares the seams.\nNo human seam approval\ninside the run.", "lineHeight": 1.25},
    {"type": "rectangle", "id": "d2", "x": 520, "y": 850, "width": 400, "height": 120, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "#fef3c7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 220054, "version": 1, "versionNonce": 220055, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false},
    {"type": "text", "id": "t_d2", "x": 536, "y": 866, "width": 370, "height": 95, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 220056, "version": 1, "versionNonce": 220057, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Runner gate deterministic.\nModel review is a report.\nTests, 1 commit, allowed files.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Runner gate deterministic.\nModel review is a report.\nTests, 1 commit, allowed files.", "lineHeight": 1.25},
    {"type": "rectangle", "id": "d3", "x": 960, "y": 850, "width": 400, "height": 120, "angle": 0, "strokeColor": "#1e3a5f", "backgroundColor": "#dbeafe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 220058, "version": 1, "versionNonce": 220059, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false},
    {"type": "text", "id": "t_d3", "x": 976, "y": 866, "width": 370, "height": 95, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 220060, "version": 1, "versionNonce": 220061, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Parallel only when files\nare disjoint. Else strictly\nsequential.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Parallel only when files\nare disjoint. Else strictly\nsequential.", "lineHeight": 1.25},
    {"type": "rectangle", "id": "d4", "x": 1400, "y": 850, "width": 400, "height": 120, "angle": 0, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 220062, "version": 1, "versionNonce": 220063, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false},
    {"type": "text", "id": "t_d4", "x": 1416, "y": 866, "width": 370, "height": 95, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 220064, "version": 1, "versionNonce": 220065, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Effort barbell: plan max,\nimplement medium, review\nin a separate context.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Effort barbell: plan max,\nimplement medium, review\nin a separate context.", "lineHeight": 1.25},

    {"type": "rectangle", "id": "band3", "x": 40, "y": 1050, "width": 1800, "height": 540, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 330001, "version": 1, "versionNonce": 330002, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false},
    {"type": "text", "id": "b3_title", "x": 70, "y": 1066, "width": 1200, "height": 34, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 330003, "version": 1, "versionNonce": 330004, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "3. Where I am still unsure", "fontSize": 24, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "3. Where I am still unsure", "lineHeight": 1.25},
    {"type": "text", "id": "b3_sub", "x": 70, "y": 1102, "width": 1500, "height": 22, "angle": 0, "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 330005, "version": 1, "versionNonce": 330006, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "The review: subagent in the session, or two fresh processes? And which CLI for the implement role?", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The review: subagent in the session, or two fresh processes? And which CLI for the implement role?", "lineHeight": 1.25},

    {"type": "rectangle", "id": "optA", "x": 90, "y": 1170, "width": 760, "height": 210, "angle": 0, "strokeColor": "#6d28d9", "backgroundColor": "#ddd6fe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 330010, "version": 1, "versionNonce": 330011, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false},
    {"type": "text", "id": "t_optA", "x": 110, "y": 1186, "width": 720, "height": 185, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 330012, "version": 1, "versionNonce": 330013, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Option A: subagent in the session\n\n/code-review starts two parallel sub-agents\n(Standards and Spec).\nSame session process, separate contexts.\nCheap. No new boot tax.", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Option A: subagent in the session\n\n/code-review starts two parallel sub-agents\n(Standards and Spec).\nSame session process, separate contexts.\nCheap. No new boot tax.", "lineHeight": 1.25},
    {"type": "rectangle", "id": "optB", "x": 990, "y": 1170, "width": 760, "height": 210, "angle": 0, "strokeColor": "#1e3a5f", "backgroundColor": "#3b82f6", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 330014, "version": 1, "versionNonce": 330015, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false},
    {"type": "text", "id": "t_optB", "x": 1010, "y": 1186, "width": 720, "height": 185, "angle": 0, "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 330016, "version": 1, "versionNonce": 330017, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Option B: two fresh processes\n\npython3 batch.py review starts two new sessions\non a detached snapshot: claude -p or codex exec,\nno resume flags.\nFull isolation. Every start pays boot tax.", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Option B: two fresh processes\n\npython3 batch.py review starts two new sessions\non a detached snapshot: claude -p or codex exec,\nno resume flags.\nFull isolation. Every start pays boot tax.", "lineHeight": 1.25},
    {"type": "rectangle", "id": "qmark", "x": 885, "y": 1245, "width": 70, "height": 70, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "#fef3c7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 330018, "version": 1, "versionNonce": 330019, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false},
    {"type": "text", "id": "t_qmark", "x": 905, "y": 1264, "width": 40, "height": 34, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 330020, "version": 1, "versionNonce": 330021, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "?", "fontSize": 30, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "?", "lineHeight": 1.25},

    {"type": "rectangle", "id": "bootbox", "x": 90, "y": 1420, "width": 760, "height": 150, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "#fef3c7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 330022, "version": 1, "versionNonce": 330023, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false},
    {"type": "text", "id": "t_bootbox", "x": 110, "y": 1436, "width": 720, "height": 125, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 330024, "version": 1, "versionNonce": 330025, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Boot tax\n\nThe fixed tokens a new process pays before it\nreads the task: system prompt, project files,\nskill text. Every extra process pays again.", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Boot tax\n\nThe fixed tokens a new process pays before it\nreads the task: system prompt, project files,\nskill text. Every extra process pays again.", "lineHeight": 1.25},
    {"type": "rectangle", "id": "qbox", "x": 990, "y": 1420, "width": 760, "height": 150, "angle": 0, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 330026, "version": 1, "versionNonce": 330027, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false},
    {"type": "text", "id": "t_qbox", "x": 1010, "y": 1436, "width": 720, "height": 125, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 330028, "version": 1, "versionNonce": 330029, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "My open questions\n\nReview as subagent or as two fresh processes?\nIs the extra boot tax worth it?\nclaude -p or codex exec for the implement role?\nIntegration review only when a wave is larger than 1?", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "My open questions\n\nReview as subagent or as two fresh processes?\nIs the extra boot tax worth it?\nclaude -p or codex exec for the implement role?\nIntegration review only when a wave is larger than 1?", "lineHeight": 1.25},

    {"type": "text", "id": "src", "x": 70, "y": 1590, "width": 1600, "height": 22, "angle": 0, "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 330030, "version": 1, "versionNonce": 330031, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Sources: implement/SKILL.md, tdd/SKILL.md, code-review/SKILL.md, ask-matt, Artifact Relay (Landsteiner, praised by Mark Kashef), Matt Pocock.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Sources: implement/SKILL.md, tdd/SKILL.md, code-review/SKILL.md, ask-matt, Artifact Relay (Landsteiner, praised by Mark Kashef), Matt Pocock.", "lineHeight": 1.25}
