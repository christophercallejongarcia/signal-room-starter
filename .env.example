# Browser-facing bridge location. Keep the bridge on localhost by default.
NEXT_PUBLIC_STRATEGY_BRIDGE_URL=http://127.0.0.1:3211

# Comma-separated web origins allowed to call the bridge.
BRIDGE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BRIDGE_PORT=3211

# Optional Codex controls. The bridge uses the local Codex authentication context.
CODEX_MODEL=
CODEX_REASONING_EFFORT=medium
CODEX_WORKING_DIRECTORY=

# Chris' face stills for Cover Lab ("face") and the Thumbnail-Builder. Absolute
# folder outside every repo; optionally pick file names in it, comma-separated.
SIGNAL_ROOM_FACE_DIR=
SIGNAL_ROOM_FACE_FILES=
# Optional thumbnail rule set (absolute Markdown path) the planner follows.
SIGNAL_ROOM_THUMBNAIL_RULES=

# Apify (server only). Get a token at console.apify.com
# The daily sweep runs in Convex and reads the deployment's own copy:
#   npx convex env set APIFY_TOKEN <token>
APIFY_TOKEN=

# Strategy-Provider framing, browser-facing. Your positioning stays out of the repo.
NEXT_PUBLIC_STRATEGY_GOAL=
NEXT_PUBLIC_STRATEGY_AUDIENCE=

# Cost guard for Apify runs. Creators one Delta-Refresh may touch; the rest keep
# their cursor and go first next run. Dollar estimate per compute unit, used only
# when an actor run reports compute units but no dollar total.
REFRESH_CREATOR_LIMIT=25
APIFY_USD_PER_COMPUTE_UNIT=0.4
# Reels one Delta-Refresh may send to the transcript actor (strongest combined scores first).
TRANSCRIPT_LIMIT_PER_RUN=20
# Minimum combined Outlier-Scorer score for automatic transcript selection. 20 is the Outlier 2 contribution.
# Set the same variable in the Convex deployment with: npx convex env set TRANSCRIPT_SCORE_THRESHOLD 20
TRANSCRIPT_SCORE_THRESHOLD=20
# A pending transcript older than this can be recovered by a manual retry.
TRANSCRIPT_PENDING_TIMEOUT_MINUTES=10
# Set the same random value in `.env.local` and with
# `npx convex env set TRANSCRIPT_ANALYSIS_WORKER_TOKEN <random-secret>`.
TRANSCRIPT_ANALYSIS_WORKER_TOKEN=

# YouTube Data API v3 (server only). Google Cloud Console key restricted to "YouTube Data API v3".
# The Convex daily sweep leaves YouTube channels out until the deployment has its own copy:
#   npx convex env set YOUTUBE_API_KEY <key>
YOUTUBE_API_KEY=
# Suchlauf bounds: videos per search term (max 50), publication window in days,
# channels measured per run, and the view floor for a Kandidat.
YOUTUBE_SEARCH_RESULTS_PER_TERM=50
YOUTUBE_SEARCH_WINDOW_DAYS=90
YOUTUBE_SEARCH_CHANNEL_LIMIT=150
YOUTUBE_CANDIDATE_MIN_VIEWS=5000
# YouTube watchlist channels one refresh may touch (quota, no Apify cost).
YOUTUBE_REFRESH_CHANNEL_LIMIT=100
# Units one search.list call takes from the 10,000-unit pot. 0 = search has its own
# pot of 100 calls a day (Google's current model); 100 = classic model.
YOUTUBE_SEARCH_UNIT_COST=0

# Instagram Trend Radar. Comma-separated values override the checked-in list;
# posts are collected only through the Instagram hashtag adapter.
INSTAGRAM_HASHTAGS=#kitools,#claude,#kiagenten,#vibecoding
INSTAGRAM_HASHTAG_RESULTS_PER_TAG=50
INSTAGRAM_HASHTAG_COST_LIMIT_USD=1
